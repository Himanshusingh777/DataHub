# CrossTecch — production secrets for docker-compose.
# Copy to `.env` on the server (same directory as docker-compose.yml) and
# fill in real values. Never commit the real `.env` file.

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be a 64-char hex string. Shared by both containers — encrypts stored
# connector credentials (BigQuery service accounts, API keys, etc).
CROSSTECCH_SECRET_KEY=

# Only this email sees the Admin panel and can manage users.
ADMIN_EMAIL=

# Your public URL, e.g. https://app.yourdomain.com (used for CORS + links in emails)
APP_URL=http://localhost:3000

# AI SQL Assistant (Query Studio) — https://console.groq.com/keys. Leave blank to disable.
GROQ_API_KEY=
GROQ_MODEL=

BIGQUERY_DEFAULT_LOCATION=US
BIGQUERY_DEFAULT_DATASET=crosstecch_data

# Transactional email (password reset, invites) — leave blank to disable sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
