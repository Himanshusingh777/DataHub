# Path to the Next.js app's data directory (shares the same SQLite file and
# secret key — this backend does not own or migrate that data).
CROSSTECCH_DATA_DIR=../.crosstecch

# Must match the Node app's CROSSTECCH_SECRET_KEY exactly if set there. If the
# Node app is using the auto-generated .crosstecch/secret.key file instead,
# leave this unset — this backend reads the same file.
CROSSTECCH_SECRET_KEY=

BIGQUERY_DEFAULT_DATASET=crosstecch_data
BIGQUERY_DEFAULT_LOCATION=US

# Origin of the Next.js dev server, for CORS (only needed if NOT proxying
# through Next.js rewrites).
FRONTEND_ORIGIN=http://localhost:3000
